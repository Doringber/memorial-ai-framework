# Copy to ~/MemorialData/.env (or $MEMORIAL_DATA_HOME/.env) — never into the repo or a
# cloud-synced folder. This is the only config file.
#   mkdir -p ~/MemorialData && cp .env.example ~/MemorialData/.env && chmod 600 ~/MemorialData/.env

# "production" requires both access keys below.
APP_ENV=development
LOG_LEVEL=info

# Access control — leave both empty only for local development.
# FAMILY: shared family password (chat, זכור / שכח).
# ADMIN: uploads, memories, persona drafts.
FAMILY_ACCESS_KEY=
ADMIN_ACCESS_KEY=
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Local-only by default. Anything that sends family data off this machine
# (anthropic, openai, Ollama ":cloud" models, elevenlabs, gtts, openai
# embeddings) is refused at startup unless this is true.
ALLOW_EXTERNAL_SERVICES=false
# Write every question/answer to data/memories/conversations.jsonl.
SAVE_CONVERSATION_LOG=false

# LLM — "ollama" (local) or, with ALLOW_EXTERNAL_SERVICES=true, "anthropic"/"openai".
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=16384
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Retrieval. Changing EMBEDDING_MODEL requires a rebuild:
#   python -m scripts.reingest <person_id>
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-base
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=3
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_POOL_SIZE=12

# Voice. "none" until a local voice engine is set up. "elevenlabs"/"gtts" are external.
STT_PROVIDER=whisper
TTS_PROVIDER=none
ALLOW_ELEVENLABS_TTS=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v4
ELEVENLABS_STABILITY=0.70
ELEVENLABS_SIMILARITY_BOOST=0.99
ELEVENLABS_MONTHLY_CHAR_LIMIT=20000

# Telegram Bot (optional — create via @BotFather, then POST /api/telegram/register-webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_VOICE_REPLIES=voice_only
